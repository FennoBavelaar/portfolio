---
import Base from '../layouts/Base.astro';
import { site } from '../lib/site';
// De lange tekst staat in src/data/over-mij.md (ook te bewerken via de CMS).
import { Content as OverMij } from '../data/over-mij.md';

---

<Base title="Over mij" description={`Over ${site.name}. Kort gehouden. Min of meer.`}>
  <section class="wrap about">
    <h1 class="page-title">Over mij</h1>

    <div class="about__text">
      <p class="about__lead">
        Oké, laten we het kort houden...<button
          id="about-toggle"
          class="about__toggle"
          type="button"
          aria-expanded="false"
          aria-controls="about-meer"
          ><span class="about__label about__label--more">meer tonen</span><span class="about__label about__label--less" aria-hidden="true"
            >minder tonen</span
          ></button
        >
      </p>

      <div id="about-meer" class="about__more" hidden>
        <div class="about__more-inner">
          <OverMij />
        </div>
      </div>
      <div class="about__spacer" aria-hidden="true"></div>
    </div>
  </section>
</Base>

<style>
  .about__text {
    max-width: 46rem;
    font-size: var(--step-1);
    line-height: 1.55;
  }
  .about__lead {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--step-3);
    line-height: 1.12;
    margin: 0;
  }
  /* De knop staat inline direct achter de "...". Beide labels zitten in dezelfde
     grid-cel, zodat de knop altijd even breed is en nooit verspringt of wrapt. */
  .about__toggle {
    display: inline-grid;
    vertical-align: baseline;
    margin-left: 0.35em;
    padding: 0.2em 0.75em 0.25em;
    border: 1.5px solid var(--blue);
    border-radius: 999px;
    background: transparent;
    color: var(--blue);
    font-family: var(--font-body);
    font-size: max(0.95rem, 0.38em);
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: 0.01em;
    white-space: nowrap;
    position: relative;
    top: -0.2em;
    transition: background 0.2s, color 0.2s, border-color 0.2s;
  }
  .about__toggle:hover {
    background: var(--blue-light);
    border-color: var(--blue-light);
    color: var(--cream);
  }
  .about__toggle[aria-expanded='true'] {
    background: var(--blue);
    color: var(--cream);
  }
  .about__toggle[aria-expanded='true']:hover {
    background: var(--blue-light);
  }
  .about__label {
    grid-area: 1 / 1;
    text-align: center;
  }
  .about__label--less,
  .about__toggle[aria-expanded='true'] .about__label--more {
    visibility: hidden;
  }
  .about__toggle[aria-expanded='true'] .about__label--less {
    visibility: visible;
  }

  .about__more {
    overflow: hidden;
    overflow-anchor: none;
  }
  .about__more-inner {
    padding-top: 1.75rem;
  }
  .about__more-inner :global(em) {
    opacity: 0.8;
  }
  .about__spacer {
    height: 0;
    overflow-anchor: none;
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { reducedMotion } from '../scripts/motion';
  import { lenis } from '../scripts/smooth';

  const btn = document.getElementById('about-toggle') as HTMLButtonElement;
  const more = document.getElementById('about-meer') as HTMLElement;
  const paras = [...more.querySelectorAll('p')];
  const spacer = document.querySelector<HTMLElement>('.about__spacer')!;
  const labelMore = btn.querySelector('.about__label--more')!;
  const labelLess = btn.querySelector('.about__label--less')!;
  let spacerH = 0;

  const docHeight = () => document.documentElement.scrollHeight;
  const setSpacer = (h: number) => {
    spacerH = Math.max(0, Math.round(h));
    spacer.style.height = `${spacerH}px`;
  };

  /** Houdt de knop op exact dezelfde plek in beeld (vangnet tegen elke verspringing). */
  function pin(before: number) {
    const diff = btn.getBoundingClientRect().top - before;
    if (Math.abs(diff) < 0.5) return;
    if (lenis) lenis.scrollTo(window.scrollY + diff, { immediate: true, force: true });
    else window.scrollTo(0, window.scrollY + diff);
  }

  function setExpanded(open: boolean) {
    btn.setAttribute('aria-expanded', String(open));
    labelMore.toggleAttribute('aria-hidden', open);
    labelLess.toggleAttribute('aria-hidden', !open);
  }

  function open() {
    const top = btn.getBoundingClientRect().top;
    setExpanded(true);
    setSpacer(0);
    more.hidden = false;
    pin(top);
    if (reducedMotion()) return;
    gsap.killTweensOf([more, paras]);
    gsap.fromTo(more, { height: 0 }, { height: 'auto', duration: 0.9, ease: 'expo.out', onUpdate: () => pin(top) });
    gsap.fromTo(paras, { opacity: 0, y: 14 }, { opacity: 1, y: 0, duration: 0.6, ease: 'power2.out', stagger: 0.045, delay: 0.05 });
  }

  function close() {
    const top = btn.getBoundingClientRect().top;
    setExpanded(false);
    // Zorg dat de pagina niet korter wordt dan nodig om de knop op z'n plek te houden.
    const finalHeight = docHeight() - more.offsetHeight;
    setSpacer(window.scrollY + window.innerHeight - finalHeight);

    const done = () => {
      more.hidden = true;
      gsap.set(more, { clearProps: 'height' });
      gsap.set(paras, { clearProps: 'opacity,transform' });
      pin(top);
    };
    if (reducedMotion()) return done();
    gsap.killTweensOf([more, paras]);
    gsap.to(paras, { opacity: 0, y: -6, duration: 0.25, ease: 'power1.in', stagger: { each: 0.015, from: 'end' } });
    gsap.fromTo(more, { height: more.offsetHeight }, { height: 0, duration: 0.6, ease: 'expo.inOut', onUpdate: () => pin(top), onComplete: done });
  }

  btn.addEventListener('click', () => (btn.getAttribute('aria-expanded') === 'true' ? close() : open()));

  // De extra ruimte onderaan krimpt weer weg zodra je omhoog scrolt.
  window.addEventListener(
    'scroll',
    () => {
      if (!spacerH) return;
      const needed = window.scrollY + window.innerHeight - (docHeight() - spacerH);
      if (needed < spacerH) setSpacer(needed);
    },
    { passive: true },
  );
</script>
