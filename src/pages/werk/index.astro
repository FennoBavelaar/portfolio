---
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getProjects, TYPE_LABELS, typeKey } from '../../lib/projects';
import { PROJECT_TYPES } from '../../content.config';

const projects = await getProjects();
const counts = Object.fromEntries(PROJECT_TYPES.map((t) => [t, projects.filter((p) => p.data.type === t).length]));
const types = PROJECT_TYPES.filter((t) => counts[t] > 0);
---

<Base title="Werk" description="Een overzicht van alle projecten: commercials, videoclips, short films, branded content en documentaires.">
  <div class="wrap">
    <h1 class="page-title">Werk</h1>

    <div class="toolbar">
      <div class="filters" role="group" aria-label="Filter op type">
        <button class="btn" type="button" data-filter="alles" aria-pressed="true">Alles <sup>{projects.length}</sup></button>
        {
          types.map((t) => (
            <button class="btn" type="button" data-filter={typeKey(t)} aria-pressed="false">
              {TYPE_LABELS[t]} <sup>{counts[t]}</sup>
            </button>
          ))
        }
      </div>
      <div class="view-toggle" role="group" aria-label="Weergave">
        <button class="btn" type="button" data-view="grid" aria-pressed="true">
          <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><path fill="currentColor" d="M0 0h6v6H0zM8 0h6v6H8zM0 8h6v6H0zM8 8h6v6H8z"/></svg>
          Grid
        </button>
        <button class="btn" type="button" data-view="lijst" aria-pressed="false">
          <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><path fill="currentColor" d="M0 1h14v2H0zM0 6h14v2H0zM0 11h14v2H0z"/></svg>
          Lijst
        </button>
      </div>
    </div>

    <p class="results visually-hidden" aria-live="polite"></p>

    <div class="projects" data-view="grid">
      {projects.map((p, i) => <ProjectCard project={p} eager={i < 2} headingLevel="h2" />)}
    </div>
    <p class="empty" hidden>Niets gevonden in deze categorie. Nog niet, tenminste.</p>
  </div>

  <div class="list-preview" aria-hidden="true">
    <img alt="" width="1600" height="900" />
    <video muted loop playsinline preload="none"></video>
  </div>
</Base>

<style>
  .toolbar {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    margin-bottom: clamp(1.5rem, 4vw, 3rem);
  }
  .filters,
  .view-toggle {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .filters sup {
    font-size: 0.65em;
    opacity: 0.7;
    margin-left: -0.15em;
  }
  .empty {
    padding: 3rem 0;
    font-size: var(--step-1);
  }

  /* --- Grid --- */
  .projects[data-view='grid'] {
    display: grid;
    gap: clamp(2rem, 4vw, 3.5rem) clamp(1rem, 2.5vw, 2rem);
  }
  @media (min-width: 40em) {
    .projects[data-view='grid'] {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 75em) {
    .projects[data-view='grid'] {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* --- Lijst --- */
  .projects[data-view='lijst'] {
    border-top: 1px solid var(--blue-20);
  }
  .projects[data-view='lijst'] :global(.card) {
    border-bottom: 1px solid var(--blue-20);
  }
  .projects[data-view='lijst'] :global(.card__link) {
    display: grid;
    grid-template-columns: 6.5rem 1fr;
    align-items: center;
    gap: 1rem;
    padding: 0.9rem 0;
  }
  .projects[data-view='lijst'] :global(.card__meta) {
    padding: 0;
  }
  .projects[data-view='lijst'] :global(.card__title) {
    font-size: var(--step-1);
  }
  @media (hover: hover) and (pointer: fine) {
    .projects[data-view='lijst'] :global(.card__link) {
      grid-template-columns: 1fr;
      padding: 1.25rem 0;
    }
    .projects[data-view='lijst'] :global(.card__media) {
      display: none;
    }
    .projects[data-view='lijst'] :global(.card__meta) {
      display: grid;
      grid-template-columns: 1fr auto;
      align-items: baseline;
      gap: 1rem;
      transition: transform 0.45s var(--ease-out);
    }
    .projects[data-view='lijst'] :global(.card__title) {
      font-size: var(--step-3);
    }
    .projects[data-view='lijst'] :global(.card__sub) {
      margin: 0;
      gap: 0.6rem;
    }
    .projects[data-view='lijst'] :global(.card__link:hover .card__meta) {
      transform: translateX(0.75rem);
    }
  }

  /* Preview die de cursor volgt (alleen lijst, alleen desktop) */
  .list-preview {
    position: fixed;
    left: 0;
    top: 0;
    z-index: 50;
    width: clamp(16rem, 26vw, 24rem);
    aspect-ratio: 16 / 9;
    border-radius: var(--radius);
    overflow: hidden;
    pointer-events: none;
    opacity: 0;
    scale: 0.85;
    transition: opacity 0.25s, scale 0.35s var(--ease-out);
    box-shadow: 0 20px 50px var(--blue-20);
    background: var(--blue);
  }
  .list-preview.is-visible {
    opacity: 1;
    scale: 1;
  }
  .list-preview img,
  .list-preview video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { initHoverPreviews } from '../../scripts/previews';
  import { finePointer, reducedMotion } from '../../scripts/motion';

  const container = document.querySelector<HTMLElement>('.projects')!;
  const cards = [...container.querySelectorAll<HTMLElement>('.card')];
  const empty = document.querySelector<HTMLElement>('.empty')!;
  const results = document.querySelector<HTMLElement>('.results')!;
  const filterBtns = [...document.querySelectorAll<HTMLButtonElement>('[data-filter]')];
  const viewBtns = [...document.querySelectorAll<HTMLButtonElement>('[data-view]')].filter((b) => b.tagName === 'BUTTON');

  initHoverPreviews(container);

  // ---------- Filters ----------
  function applyFilter(type: string, animate = true) {
    filterBtns.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.filter === type)));
    const visible = cards.filter((c) => type === 'alles' || c.dataset.type === type);
    cards.forEach((c) => (c.hidden = !visible.includes(c)));
    empty.hidden = visible.length > 0;
    results.textContent = `${visible.length} project${visible.length === 1 ? '' : 'en'} zichtbaar`;
    if (animate && !reducedMotion()) {
      gsap.fromTo(visible, { opacity: 0, y: 18 }, { opacity: 1, y: 0, duration: 0.6, ease: 'expo.out', stagger: 0.05, overwrite: true });
    }
    const url = new URL(location.href);
    type === 'alles' ? url.searchParams.delete('type') : url.searchParams.set('type', type);
    history.replaceState(null, '', url);
  }
  filterBtns.forEach((b) => b.addEventListener('click', () => applyFilter(b.dataset.filter!)));
  const initial = new URL(location.href).searchParams.get('type');
  if (initial && filterBtns.some((b) => b.dataset.filter === initial)) applyFilter(initial, false);

  // ---------- Grid / lijst ----------
  const store = {
    get: () => {
      try {
        return localStorage.getItem('werk-view');
      } catch {
        return null;
      }
    },
    set: (v: string) => {
      try {
        localStorage.setItem('werk-view', v);
      } catch {}
    },
  };
  function setView(view: string) {
    container.dataset.view = view;
    viewBtns.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.view === view)));
    store.set(view);
    // in lijstweergave op desktop: geen "bekijk"-cirkel, de preview zegt genoeg
    container.querySelectorAll<HTMLElement>('.card__link').forEach((a) => {
      if (view === 'lijst' && finePointer()) a.dataset.cursor = 'hidden';
      else a.dataset.cursor = 'view';
    });
  }
  viewBtns.forEach((b) => b.addEventListener('click', () => setView(b.dataset.view!)));
  const saved = store.get();
  if (saved === 'lijst') setView('lijst');

  // ---------- Preview volgt de cursor (lijst, desktop) ----------
  const preview = document.querySelector<HTMLElement>('.list-preview')!;
  if (finePointer()) {
    const img = preview.querySelector('img')!;
    const vid = preview.querySelector('video')!;
    const dur = reducedMotion() ? 0 : 0.6;
    const xTo = gsap.quickTo(preview, 'x', { duration: dur, ease: 'power3' });
    const yTo = gsap.quickTo(preview, 'y', { duration: dur, ease: 'power3' });
    const rTo = gsap.quickTo(preview, 'rotate', { duration: 0.8, ease: 'power3' });
    let lastX = 0;

    window.addEventListener('pointermove', (e) => {
      if (container.dataset.view !== 'lijst') return;
      const w = preview.offsetWidth;
      const h = preview.offsetHeight;
      const x = Math.min(e.clientX + 24, window.innerWidth - w - 16);
      xTo(x);
      yTo(e.clientY - h / 2);
      if (!reducedMotion()) rTo(gsap.utils.clamp(-8, 8, (e.clientX - lastX) * 0.6));
      lastX = e.clientX;
    });

    cards.forEach((card) => {
      const link = card.querySelector('.card__link')!;
      link.addEventListener('mouseenter', () => {
        if (container.dataset.view !== 'lijst') return;
        const thumb = card.querySelector('img')!;
        const v = card.querySelector<HTMLVideoElement>('video');
        img.src = thumb.src;
        vid.removeAttribute('src');
        vid.style.opacity = '0';
        if (v?.dataset.src && !reducedMotion()) {
          vid.src = v.dataset.src;
          vid.play().then(() => (vid.style.opacity = '1')).catch(() => {});
        }
        preview.classList.add('is-visible');
      });
      link.addEventListener('mouseleave', () => {
        preview.classList.remove('is-visible');
        vid.pause();
      });
    });
  }
</script>
